{
  "name": "@loyalty-program/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Entorno backend; sin implementación de aplicación",
  "engines": {
    "node": "24.18.1",
    "npm": "12.1.0"
  },
  "packageManager": "npm@12.1.0",
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1"
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm run test:tooling",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tooling": "vitest run --project tooling",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --project unit --project integration --project e2e --coverage",
    "generate": "npm run test:tooling && drizzle-kit generate",
    "migrate": "npm run test:tooling && drizzle-kit migrate --config drizzle.migrate.config.ts",
    "db:check": "drizzle-kit check",
    "skills:install": "node scripts/install-skills.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
