# Copiar a .env SOLO si no existe; nunca sobrescribir credenciales existentes.
DATABASE_URL=postgresql://loyalty:local_only@localhost:5432/loyalty_dev
# Solo pruebas locales; requiere permiso CREATEDB y prefijo loyalty_test_.
TEST_DATABASE_URL=postgresql://loyalty:local_only@localhost:5432/loyalty_test_control
PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-project-key
# Generar localmente 32 bytes hex aleatorios; no usar este marcador.
CARD_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
# Orígenes explícitos separados por coma; vacío no habilita CORS.
CORS_ORIGINS=http://localhost:5173
