# Copiar a .env solo si no existe. El entorno del host tiene precedencia.
# backend/.env existente se conserva como fallback local.
# DATABASE_URL es obligatoria: usa Connect en Supabase o la conexión ya existente.
# No actives un ejemplo localhost si tu base está alojada en Supabase.
# DATABASE_URL=postgresql://usuario:password@host:5432/postgres
APP_ORIGIN=http://localhost:3000
# En el hosting: APP_ORIGIN=https://dominio-publico-real (sin ruta ni barra final).
PORT=3000
HOST=0.0.0.0
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-project-key
# Generar una sola vez: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CARD_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
CORS_ORIGINS=
