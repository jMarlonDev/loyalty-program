# Copiar a .env solo si no existe. El entorno del host tiene precedencia.
# backend/.env existente se conserva como fallback local.
# DATABASE_URL es obligatoria: usa Connect en Supabase o la conexión ya existente.
# No actives un ejemplo localhost si tu base está alojada en Supabase.
# DATABASE_URL=postgresql://usuario:password@host:5432/postgres
APP_ORIGIN=http://localhost:3000
# Para probar en la misma red con npm run dev: APP_ORIGIN=http://192.168.33.9:3000
# --host debe escuchar en esa IP. Abre la misma URL en computador y celular.
# En el hosting: APP_ORIGIN=https://dominio-publico-real (sin ruta ni barra final).
PORT=3000
HOST=0.0.0.0
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-public-project-key
# Generar una sola vez: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CARD_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
CORS_ORIGINS=
# Opcional: solo para npm run accounts:seed; nunca se envía al navegador.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-admin-key

# AUTH-LOCAL-001 (D-07): login de admin/empleados. local (por defecto) = correo + contraseña
# con scrypt en PostgreSQL; supabase = Supabase Auth (requiere SUPABASE_URL y clave pública).
AUTH_PROVIDER=local

# D-06: espera entre sellos (minutos). Solo en desarrollo; producción usa la del programa (240 por defecto).
# STAMP_COOLDOWN_MINUTES=1
