{
  "name": "loyalty-program",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "npm run routes:generate && tsc --noEmit && npm run typecheck --workspace backend",
    "lint": "biome check . && npm run lint --workspace backend",
    "format": "biome check --write . && npm run format --workspace backend",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "test": "vitest run",
    "test:unit": "npm run test && npm run test:tooling --workspace backend && npm run test:unit --workspace backend",
    "test:db": "npm run test:db --workspace backend --",
    "test:browser": "node scripts/browser-tests.mjs",
    "generate": "npm run generate --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "db:check": "npm run db:check --workspace backend",
    "test:browser:db": "node backend/scripts/test-db.mjs --browser",
    "env:check": "node --import tsx scripts/env-check.ts",
    "test:browser:production": "node backend/scripts/test-db.mjs --browser --production",
    "routes:generate": "node scripts/generate-routes.mjs"
  },
  "description": "Sistema de fidelización para restaurantes basado en tarjetas digitales y sellos.",
  "engines": {
    "node": "24.18.1",
    "npm": "12.1.0"
  },
  "packageManager": "npm@12.1.0",
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "@zxing/browser": "0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.8",
    "lucide-react": "1.59.0",
    "nitro": "3.0.260903-beta",
    "pg": "8.23.1",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.45",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "srvx": "1.0.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
